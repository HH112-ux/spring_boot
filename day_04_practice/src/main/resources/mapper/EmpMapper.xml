<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jh.mapper.EmpMapper">

    <insert id="insertEmp" parameterType="com.jh.entity.Emp" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO emp (name, addr, dept, age)
        VALUES (#{name}, #{addr}, #{dept}, #{age})
    </insert>

    <delete id="deleteById">
        DELETE FROM emp WHERE id = #{id}
    </delete>

    <delete id="deleteByCondition" parameterType="com.jh.entity.Emp">
        DELETE FROM emp
        <where>
            <if test="emp.name != null and emp.name != ''">
                AND name = #{emp.name}
            </if>
            <if test="emp.addr != null and emp.addr != ''">
                AND addr = #{emp.addr}
            </if>
            <if test="emp.dept != null and emp.dept != ''">
                AND dept = #{emp.dept}
            </if>
            <if test="emp.age != null">
                AND age = #{emp.age}
            </if>
        </where>
    </delete>

    <update id="updateById" parameterType="com.jh.entity.Emp">
        UPDATE emp
        <set>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="addr != null and addr != ''">addr = #{addr},</if>
            <if test="dept != null and dept != ''">dept = #{dept},</if>
            <if test="age != null">age = #{age},</if>
        </set>
        WHERE id = #{id}
    </update>

    <select id="findAll" resultType="com.jh.entity.Emp">
        SELECT * FROM emp
    </select>

    <select id="findById" resultType="com.jh.entity.Emp">
        SELECT * FROM emp WHERE id = #{id}
    </select>

    <select id="findByCondition" resultType="com.jh.entity.Emp">
        SELECT * FROM emp
        <where>
            <if test="emp.name != null and emp.name != ''">
                AND name = #{emp.name}
            </if>
            <if test="emp.addr != null and emp.addr != ''">
                AND addr = #{emp.addr}
            </if>
            <if test="emp.dept != null and emp.dept != ''">
                AND dept = #{emp.dept}
            </if>
            <if test="emp.age != null">
                AND age = #{emp.age}
            </if>
        </where>
    </select>

</mapper>
